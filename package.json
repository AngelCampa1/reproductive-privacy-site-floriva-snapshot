{
  "name": "floriva-web",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.17.1 <23"
  },
  "scripts": {
    "dev": "vite",
    "predev": "pnpm generate:content",
    "generate:content": "node scripts/build-content-data.mjs",
    "generate:knowledge": "node scripts/build-public-knowledge.mjs",
    "prebuild": "pnpm generate:content && pnpm generate:knowledge",
    "pretest": "pnpm generate:content && pnpm generate:knowledge",
    "pretypecheck": "pnpm generate:content && pnpm generate:knowledge",
    "build": "node scripts/build-sitemap.mjs && node scripts/build-llms-txt.mjs && node scripts/generate-og-images.mjs && tsc -b && vite build && node scripts/prerender-html.mjs && node scripts/verify-prerender-bundle.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "migrate:remote": "node scripts/apply-remote-d1-migrations.mjs",
    "verify:deploy-readiness": "pnpm verify:product-alignment && pnpm verify:lead-magnets && node scripts/verify-lead-magnet-d1.mjs && node scripts/verify-cloudflare-deploy-config.mjs",
    "verify:lead-magnets": "node scripts/verify-lead-magnet-r2.mjs",
    "verify:lead-magnet:prod-smoke": "node scripts/verify-lead-magnet-e2e.mjs --public-smoke",
    "verify:lead-magnet:prod-full": "node scripts/verify-lead-magnet-e2e.mjs --public-smoke --signed-links",
    "verify:product-alignment": "node scripts/verify-product-marketing-alignment.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "audit:claims": "node scripts/audit-claims.mjs",
    "freeze:claims-baseline": "node scripts/freeze-claims-baseline.mjs",
    "prepare:pages-rollback": "node scripts/prepare-pages-rollback.mjs",
    "backup:private-seo-evidence": "node scripts/backup-private-seo-evidence.mjs",
    "manifest:content-batch": "node scripts/write-content-batch-manifest.mjs",
    "test:claims": "vitest run scripts/claim-remediation.test.ts",
    "verify:redirects": "node scripts/verify-redirects.mjs",
    "verify:seo": "node scripts/verify-seo-surface.mjs",
    "verify:prod-seo-health": "node scripts/verify-production-seo-health.mjs",
    "verify:seo-funnel-browser": "node scripts/verify-seo-funnel-browser.mjs",
    "verify:seo-funnel-browser:local": "pnpm verify:seo-funnel-browser -- --origin http://localhost:4173",
    "verify:seo-funnel-browser:local:mobile": "pnpm verify:seo-funnel-browser -- --origin http://localhost:4173 --mobile",
    "verify:seo-funnel-browser:prod": "pnpm verify:seo-funnel-browser -- --origin %FLORIVA_PROD_URL%",
    "verify:seo-funnel-browser:prod:mobile": "pnpm verify:seo-funnel-browser -- --origin %FLORIVA_PROD_URL% --mobile",
    "verify:prerendered-content": "node scripts/verify-prerendered-content.mjs",
    "verify:prerender-bundle": "node scripts/verify-prerender-bundle.mjs",
    "verify:mobile-layout": "node scripts/verify-mobile-layout-browser.mjs --origin http://localhost:4173 --warn-as-error",
    "verify:mobile-layout:fast": "node scripts/verify-mobile-layout-browser.mjs --origin http://localhost:4173 --archetypes-only --no-fullpage --warn-as-error",
    "verify:mobile-layout:routes": "node scripts/verify-mobile-layout-browser.mjs --print-routes",
    "verify:mobile-layout:prod": "node scripts/verify-mobile-layout-browser.mjs --origin %FLORIVA_PROD_URL% --warn-as-error",
    "verify:mobile-gate-selftest": "node scripts/verify-mobile-gate-selftest.mjs --origin http://localhost:4173",
    "verify:redirects:local": "pnpm verify:redirects -- --origin http://localhost:8788",
    "verify:redirects:prod": "pnpm verify:redirects -- --origin %FLORIVA_PROD_URL%",
    "verify:funnel:local": "pnpm verify:product-alignment && pnpm verify:seo400-backlog -- --min 400 && pnpm verify:seo400-content && pnpm verify:seo-funnel-browser -- --origin http://localhost:4173 && pnpm verify:seo-funnel-browser -- --origin http://localhost:4173 --mobile && pnpm verify:seo400-browser -- --origin http://localhost:4173 --paths docs/seo-400/net-new-paths.txt && pnpm verify:seo400-browser -- --origin http://localhost:4173 --paths docs/seo-400/net-new-paths.txt --mobile",
    "verify:funnel:prod": "pnpm verify:seo && pnpm verify:prod-seo-health && pnpm verify:redirects:prod && pnpm check:links && pnpm verify:seo400:prod && pnpm verify:seo400:prod:mobile && pnpm verify:seo-funnel-browser:prod && pnpm verify:seo-funnel-browser:prod:mobile && pnpm verify:lead-magnet:prod-smoke",
    "verify:funnel:local:full": "pnpm build && pnpm verify:deploy-readiness && pnpm verify:sources -- --fail-on-error && pnpm check:links && pnpm verify:seo400-backlog -- --min 400 && pnpm verify:seo400-content && pnpm verify:funnel:local",
    "verify:funnel:prod:full": "pnpm verify:product-alignment && pnpm verify:sources -- --fail-on-error && pnpm verify:seo400-backlog -- --min 400 && pnpm verify:seo400-content && pnpm verify:funnel:prod && pnpm export:seo400:prod-urls",
    "verify:seo400-backlog": "node scripts/verify-seo400-backlog.mjs",
    "verify:seo400-content": "node scripts/verify-seo400-content.mjs",
    "verify:seo400-browser": "node scripts/verify-seo400-browser.mjs",
    "verify:seo400:local": "pnpm verify:seo400-browser -- --origin http://localhost:4173 --paths docs/seo-400/net-new-paths.txt",
    "verify:seo400:local:mobile": "pnpm verify:seo400-browser -- --origin http://localhost:4173 --paths docs/seo-400/net-new-paths.txt --mobile",
    "verify:seo400:prod": "pnpm verify:seo400-browser -- --origin https://floriva.app --paths docs/seo-400/net-new-paths.txt",
    "verify:seo400:prod:mobile": "pnpm verify:seo400-browser -- --origin https://floriva.app --paths docs/seo-400/net-new-paths.txt --mobile",
    "export:prod-urls": "node scripts/export-prod-indexer-urls.mjs",
    "export:seo400:prod-urls": "node scripts/export-prod-indexer-urls.mjs --paths docs/seo-400/net-new-paths.txt --out artifacts/floriva-seo400-prod-urls.txt",
    "preview": "vite preview",
    "preview:pages": "wrangler pages dev dist --compatibility-date=2026-04-21 --ip localhost --port 8788 --local-protocol=http",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "metrics": "node scripts/portfolio-metrics.mjs",
    "metrics:write": "node scripts/portfolio-metrics.mjs --write --strict",
    "test": "vitest run --exclude=.floriva-private/**",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:coverage": "vitest run --coverage --exclude=.floriva-private/**",
    "deploy:pages": "pnpm build && node scripts/strip-sourcemaps.mjs && wrangler pages deploy dist --project-name floriva-web",
    "deploy:worker": "wrangler deploy --config worker/wrangler.toml",
    "preview:worker": "wrangler dev --config worker/wrangler.toml",
    "deploy": "pnpm migrate:remote && pnpm verify:deploy-readiness && pnpm deploy:worker && pnpm deploy:pages"
  },
  "dependencies": {
    "@sentry/react": "^10.22.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.5",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@cloudflare/pages-plugin-sentry": "^1.0.0",
    "@cloudflare/workers-types": "^4.20260405.0",
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@sentry/vite-plugin": "^4.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^27.0.1",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "remark-parse": "11.0.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "unified": "11.0.5",
    "vite": "^8.0.9",
    "vitest": "^3.2.4",
    "wrangler": "^4.12.0"
  }
}
