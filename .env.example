# Copy to .env.local for Vite and the Node scripts, or to .dev.vars for
# `wrangler pages dev`. Both are gitignored. Never commit a filled-in copy.
#
# Nothing here is required to read the code, run `pnpm test`, or run
# `pnpm build` — those work on a bare clone. The variables below only matter
# once you want the interactive lead-magnet flow, error reporting, deployment,
# or the verification gates that talk to a live origin.

# ---------------------------------------------------------------------------
# Local dev: the lead-magnet form
# ---------------------------------------------------------------------------
# Turnstile keeps the subscribe endpoint from being a spam relay. The verifier
# fails closed, so in production a missing secret rejects submissions rather
# than waving them through.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the time-limited download URLs handed out in delivery emails
# (HMAC-SHA-256, 7-day default). Any sufficiently long random string.
LEAD_MAGNET_DOWNLOAD_SIGNING_SECRET=

# Shared secret between the Pages Functions and the floriva-email Worker's
# /internal/send route, compared in constant time. Set on the Worker with
# `wrangler secret put INTERNAL_SEND_SECRET`.
INTERNAL_SEND_SECRET=

# ---------------------------------------------------------------------------
# Observability (optional; the client Sentry init no-ops when the DSN is unset)
# ---------------------------------------------------------------------------
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Sourcemap upload at build time. vite.config.ts only enables the Sentry plugin
# when all three are present, so leaving them blank is a supported build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Verification gates that hit a live origin
# ---------------------------------------------------------------------------
# Target for every `verify:*:prod` script and the prod URL exports.
FLORIVA_PROD_URL=
# Address used when a gate submits the real lead-magnet form end to end.
FLORIVA_PROD_TEST_EMAIL=
# Override origins for the SEO and deploy-readiness gates. Default to
# http://localhost:4173, i.e. `pnpm preview`.
SEO_VERIFY_ORIGIN=
DEPLOY_READINESS_ORIGIN=
# Set to require the store-redirect endpoints to resolve against real listings.
REQUIRE_LIVE_STORE_REDIRECTS=
# Captured from a delivery email to prove signed links round-trip.
LEAD_MAGNET_E2E_DOWNLOAD_URL=
LEAD_MAGNET_E2E_UNSUBSCRIBE_URL=

# ---------------------------------------------------------------------------
# Deployment and object storage
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
# S3-compatible access to the lead-magnet R2 bucket, used by verify:lead-magnets.
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
LEAD_MAGNET_R2_BUCKET=

# Client-side encrypted evidence archives (AES-256-GCM before upload).
FLORIVA_PRIVATE_BACKUP_KEY_ID=
FLORIVA_PRIVATE_BACKUP_KEY=
FLORIVA_PRIVATE_BACKUP_BUCKET=

# ---------------------------------------------------------------------------
# Social scheduling (Postiz). Integration ids identify connected channels and
# are read from the environment rather than committed.
# ---------------------------------------------------------------------------
POSTIZ_CHANNEL_ID=
POSTIZ_X_ID=
POSTIZ_LINKEDIN_PAGE_ID=
POSTIZ_THREADS_ID=

# ---------------------------------------------------------------------------
# Build-time escape hatch
# ---------------------------------------------------------------------------
# Comma-separated subset for scripts/prerender-html.mjs. Leave unset to
# prerender every route; setting it to an empty string is a hard error, since
# an earlier truthiness check turned that into a full rewrite of dist/.
PRERENDER_ROUTES=
