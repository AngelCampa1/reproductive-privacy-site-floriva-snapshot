/*
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# This file exists to be READ by AI crawlers (OAI-SearchBot, PerplexityBot), so a
# blanket `X-Robots-Tag: noindex` would defeat its whole purpose - those crawlers
# honour it. Scope the directive to Googlebot instead: keeps a raw JSON blob out
# of Google Search results while leaving AI retrieval unblocked.
/public-knowledge.json
  Content-Type: application/json; charset=utf-8
  X-Robots-Tag: googlebot: noindex
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
